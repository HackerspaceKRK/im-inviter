# Authentik: token service-accounta (patrz README)
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_TOKEN=

# Matrix: konto bota + jego access token; ID pokoi (!abc:serwer), po przecinku.
# Puste MATRIX_ROOMS = część Matrix wyłączona.
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_TOKEN=
MATRIX_ROOMS=
# Przestrzenie (Spaces): bot zaprasza TYLKO do przestrzeni (ID !...:serwer), pokoje-dzieci z regułą
# "restricted" wpuszczają członków space same. Wiadomość "Dodano ... do przestrzeni ..." idzie do
# MATRIX_NOTIFY_ROOM (puste = bez wiadomości). Bot musi mieć w przestrzeni power level >= invite.
MATRIX_SPACES=
MATRIX_NOTIFY_ROOM=
# Po ilu godzinach nieprzyjęte zaproszenie trafia do matrixStatus usera (0 = wyłączone)
MATRIX_PENDING_AFTER_HOURS=24
# Typ wiadomości „Dodano …": m.text (przekazują go mosty, np. mautrix→Telegram; klienty powiadamiają)
# albo m.notice (cichy, ale mosty domyślnie go pomijają)
MATRIX_MSGTYPE=m.text

# Telegram: token z BotFathera; puste = część Telegram wyłączona.
# Czaty Telegrama rozdzielone rolą (numeryczne ID po przecinku, np. -1001234567890; bot musi być w nich adminem z „Invite users”).
# Ten sam czat w dwóch listach = błąd przy starcie.
#   TELEGRAM_MEMBERS_GROUPS: grupa dla członków. Linki, komendy i TAGI (Verified / Verified*; bot potrzebuje też „Manage tags”)
#   TELEGRAM_PUBLIC_GROUPS:  grupa publiczna. Linki i komendy, BEZ tagów
#   TELEGRAM_CHANNELS:       kanały. Tylko linki
# (Stara TELEGRAM_GROUPS działa jeszcze jak „publiczna”, bez tagów, z ostrzeżeniem w logu.)
TELEGRAM_TOKEN=
TELEGRAM_MEMBERS_GROUPS=
TELEGRAM_PUBLIC_GROUPS=
TELEGRAM_CHANNELS=

POLL_INTERVAL=60
DB_PATH=/data/state.db
LOG_LEVEL=INFO
