# Authentik: token service-accounta (patrz README)
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_TOKEN=

# Matrix: konto bota + jego access token; ID pokoi (!abc:serwer), po przecinku.
# Puste MATRIX_ROOMS = część Matrix wyłączona.
MATRIX_HOMESERVER=https://matrix.masmiks.wtf
MATRIX_TOKEN=
MATRIX_ROOMS=
# Przestrzenie (Spaces): bot zaprasza TYLKO do przestrzeni (ID !...:serwer), pokoje-dzieci z regułą
# "restricted" wpuszczają członków space same. Wiadomość "Dodano ... do przestrzeni ..." idzie do
# MATRIX_NOTIFY_ROOM (puste = bez wiadomości). Bot musi mieć w przestrzeni power level >= invite.
MATRIX_SPACES=
MATRIX_NOTIFY_ROOM=

# Telegram: token z BotFathera; puste = część Telegram wyłączona.
# TELEGRAM_GROUPS = numeryczne id grup (np. -1001234567890), bot musi być w nich adminem
TELEGRAM_TOKEN=
TELEGRAM_GROUPS=

POLL_INTERVAL=60
DB_PATH=/data/state.db
LOG_LEVEL=INFO
